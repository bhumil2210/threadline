---
import '../styles/global.css';
import { SITE_NAME } from '../lib/site';
import { absoluteUrl, jsonLd } from '../lib/seo';
import plexSans400 from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url';

interface Props {
  title: string;
  description?: string;
  /** Share image path (1200×630 PNG), e.g. /og/java/race-condition.png */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  /** Schema.org structured data for this page. */
  structuredData?: unknown;
}

const {
  title,
  description = 'Learn concurrency by watching which thread runs what.',
  image = '/og/home.png',
  imageAlt = 'Threadline: thread lanes showing which thread runs what',
  type = 'website',
  structuredData,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Vercel Web Analytics + Speed Insights only exist on Vercel deployments; elsewhere (Lighthouse CI) the scripts would 404.
const vercelInsights = import.meta.env.PROD && process.env.VERCEL === '1';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteUrl(image)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    {structuredData !== undefined && <script is:inline type="application/ld+json" set:html={jsonLd(structuredData)} />}
    <meta name="theme-color" content="#0E1014" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#F6F7F9" media="(prefers-color-scheme: light)" />
    <!-- Apply a saved theme before first paint, so there is no flash of the other theme. -->
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Only the body font is preloaded: it renders the largest text. Mono loads normally. -->
    <link rel="preload" href={plexSans400} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    {
      vercelInsights && (
        <>
          <script is:inline>
            window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
            window.si = window.si || function () { (window.siq = window.siq || []).push(arguments); };
          </script>
          <script is:inline defer src="/_vercel/insights/script.js"></script>
          <script is:inline defer src="/_vercel/speed-insights/script.js"></script>
        </>
      )
    }
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Threadline</a>
      <button type="button" class="theme-toggle" aria-label="Switch theme" title="Switch theme">
        <svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
          ></path>
        </svg>
        <svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path>
        </svg>
      </button>
    </header>
    <main>
      <slot />
    </main>
    <script>
      // Toggle between light and dark. Until the user clicks, the system setting decides.
      const root = document.documentElement;
      const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
      const current = () =>
        root.dataset.theme ?? (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
      const label = () => {
        const text = current() === 'dark' ? 'Switch to light theme' : 'Switch to dark theme';
        button?.setAttribute('aria-label', text);
        button?.setAttribute('title', text);
      };
      button?.addEventListener('click', () => {
        const next = current() === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
        label();
      });
      label();
    </script>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1120px;
    margin: 0 auto;
    padding: 10px var(--gutter) 0;
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    padding: 0;
    background: none;
    border: 0;
    border-radius: 999px;
    color: var(--muted);
    cursor: pointer;
    transition: color 120ms, background-color 120ms;
  }

  .theme-toggle:hover {
    color: var(--text);
    background: var(--surface-2);
  }

  .theme-toggle svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Show the sun in dark mode (click for light) and the moon in light mode. */
  .moon {
    display: none;
  }

  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme='dark'])) .sun {
      display: none;
    }
    :global(:root:not([data-theme='dark'])) .moon {
      display: block;
    }
  }

  :global(:root[data-theme='light']) .sun {
    display: none;
  }

  :global(:root[data-theme='light']) .moon {
    display: block;
  }

  .brand {
    font: 500 15px/1 var(--font-mono);
    letter-spacing: 0.02em;
    text-decoration: none;
    color: var(--text);
  }

  .brand::before {
    content: '';
    display: inline-block;
    width: 18px;
    height: 3px;
    margin-right: 8px;
    vertical-align: middle;
    background: linear-gradient(90deg, var(--run) 0 55%, transparent 55% 65%, var(--io) 65%);
    border-radius: 2px;
  }

  main {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 var(--gutter) 64px;
  }
</style>
