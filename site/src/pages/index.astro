---
import Base from '../layouts/Base.astro';
import { LANG_NAME, allScenarios, byGroup, scenarioUrl } from '../lib/catalog';

const java = (await allScenarios()).filter((s) => s.main.lang === 'java');
const groups = byGroup(java);
---

<Base title="Threadline: see which thread runs what">
  <h1>See which thread runs what.</h1>
  <p class="lead">
    Concurrency, animated on real thread lanes. Every scenario is checked against a real program in CI, so what you see is
    what the JVM does.
  </p>

  <h2 class="lang">{LANG_NAME.java} <span>{java.length} scenarios</span></h2>
  {
    groups.map(({ group, items }) => (
      <section class="group">
        <h3>{group}</h3>
        <ol class="list">
          {items.map(({ main: s, variants }) => (
            <li>
              <a href={scenarioUrl(s)}>
                <span class="num">{String(s.order).padStart(2, '0')}</span>
                <span class="title">{s.title}</span>
                <span class="sum">{s.summary}</span>
                {variants.length > 0 && <span class="whatif">What-if: {variants.map((v) => v.variant).join(', ')}</span>}
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
  <p class="soon">Go and Rust are next.</p>
</Base>

<style>
  h1 {
    margin: 48px 0 8px;
    font-size: clamp(28px, 5vw, 44px);
    font-weight: 600;
    line-height: 1.15;
  }

  .lead {
    margin: 0 0 40px;
    color: var(--muted);
    max-width: 60ch;
  }

  .lang {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin: 0 0 8px;
    font-size: 22px;
    font-weight: 600;
  }

  .lang span {
    font: 12px var(--font-mono);
    color: var(--muted);
  }

  .group h3 {
    margin: 28px 0 10px;
    font: 500 12px/1 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .list a {
    display: grid;
    grid-template-columns: auto 1fr;
    align-content: start;
    gap: 4px 12px;
    height: 100%;
    padding: 16px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color 120ms;
  }

  .list a:hover {
    border-color: var(--muted);
  }

  .num {
    grid-row: span 2;
    font: 500 13px/1.5 var(--font-mono);
    color: var(--accent);
  }

  .title {
    font-weight: 600;
  }

  .sum {
    font-size: 14px;
    color: var(--muted);
  }

  .whatif {
    grid-column: 2;
    margin-top: 4px;
    font: 12px var(--font-mono);
    color: var(--accent);
  }

  .soon {
    margin: 40px 0 0;
    color: var(--muted);
    font-size: 14px;
  }
</style>
