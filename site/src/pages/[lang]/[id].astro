---
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Player from '../../components/Player.svelte';
import { LANG_NAME, allScenarios, playerData, scenarioUrl, variantsUrl } from '../../lib/catalog';
import { highlightedLines, linesHtml } from '../../lib/player';
import type { Timeline } from '../../lib/timeline';
import { absoluteUrl, inlineCodeHtml, pageTitle, plainText, verifyProgramUrl } from '../../lib/seo';
import { SITE_NAME } from '../../lib/site';

export async function getStaticPaths() {
  const all = await allScenarios();
  const scenarios = all.map((s) => s.main);
  return all.map(({ main, variants }, i) => ({
    params: { lang: main.lang, id: main.id },
    props: {
      scenario: main,
      variants,
      total: scenarios.filter((s) => s.lang === main.lang).length,
      prev: scenarios[i - 1]?.lang === main.lang ? scenarios[i - 1] : undefined,
      next: scenarios[i + 1]?.lang === main.lang ? scenarios[i + 1] : undefined,
    },
  }));
}

interface Props {
  scenario: Timeline;
  variants: Timeline[];
  total: number;
  prev?: Timeline;
  next?: Timeline;
}

const { scenario, variants, total, prev, next } = Astro.props;
const timelines = [scenario, ...variants];
const player = await playerData(timelines);
// Only the main timeline goes into the page; the rest load from variants.json when needed.
const options = timelines.map((t) => ({ id: t.id, label: t.variant ?? '' }));
// The first frame's highlighted lines (t = 0), so the code looks the same before and after hydration.
const step0 = scenario.markers[0]?.line;
const hl0 = highlightedLines(scenario, 0);
const firstCode = linesHtml(player.variants[0]!.codeLines, (n) =>
  [n === step0 && 'step-line', hl0.has(n) && 'hl'].filter(Boolean).join(' '),
);
const writeup = await getEntry('writeups', `${scenario.lang}/${scenario.id}`);
const Writeup = writeup ? (await render(writeup)).Content : undefined;

const meta = writeup?.data;
const title = pageTitle(meta?.seoTitle ?? scenario.title);
const description = meta?.description ?? scenario.summary;
const faq = meta?.faq ?? [];
const url = absoluteUrl(scenarioUrl(scenario));
const image = `/og/${scenario.lang}/${scenario.id}.png`;
const program = verifyProgramUrl(scenario.lang, scenario.id);
// Same group first, so the links stay on topic; the pager already covers previous and next.
const related = (await allScenarios())
  .map((s) => s.main)
  .filter((s) => s.lang === scenario.lang && s.group === scenario.group && s.id !== scenario.id);

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['TechArticle', 'LearningResource'],
      '@id': `${url}#article`,
      headline: meta?.seoTitle ?? scenario.title,
      name: scenario.title,
      description,
      url,
      image: absoluteUrl(image),
      inLanguage: 'en',
      isAccessibleForFree: true,
      learningResourceType: 'Interactive visualization',
      educationalLevel: 'Intermediate',
      teaches: scenario.takeaway,
      about: { '@type': 'ComputerLanguage', name: LANG_NAME[scenario.lang] },
      author: { '@type': 'Person', name: 'Bhumil', url: 'https://github.com/bhumil2210' },
      publisher: { '@type': 'Organization', name: SITE_NAME, url: absoluteUrl('/') },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: `${LANG_NAME[scenario.lang]} concurrency`, item: absoluteUrl('/') },
        { '@type': 'ListItem', position: 2, name: scenario.title, item: url },
      ],
    },
    ...(faq.length > 0
      ? [
          {
            '@type': 'FAQPage',
            mainEntity: faq.map(({ q, a }) => ({
              '@type': 'Question',
              name: q,
              acceptedAnswer: { '@type': 'Answer', text: plainText(a) },
            })),
          },
        ]
      : []),
  ],
};
---

<Base
  {title}
  {description}
  {image}
  imageAlt={`Thread lanes for "${scenario.title}"`}
  type="article"
  {structuredData}
>
  <nav class="topbar" aria-label="Scenarios">
    <p class="crumbs">
      <a href="/">{LANG_NAME[scenario.lang]}</a>{' '}<span aria-hidden="true">/</span>{' '}
      {scenario.group}{' '}<span aria-hidden="true">·</span>{' '}
      {`${scenario.order} of ${total}`}
    </p>
    <div class="steppers">
      {
        prev ? (
          <a href={scenarioUrl(prev)} rel="prev" title={prev.title}>
            <span aria-hidden="true">←</span> Previous
          </a>
        ) : (
          <span class="disabled" aria-hidden="true">← Previous</span>
        )
      }
      {
        next ? (
          <a href={scenarioUrl(next)} rel="next" title={next.title}>
            Next <span aria-hidden="true">→</span>
          </a>
        ) : (
          <span class="disabled" aria-hidden="true">Next →</span>
        )
      }
    </div>
  </nav>

  <header class="intro">
    <h1>{scenario.title}</h1>
    {/* With variants, the player shows each case's summary under the what-if switch instead. */}
    {variants.length === 0 && <p class="summary">{scenario.summary}</p>}
    {
      Writeup && (
        <a class="jump" href="#explanation">
          Read the explanation <span aria-hidden="true">↓</span>
        </a>
      )
    }
  </header>

  <style is:inline set:html={player.css} />
  <Player client:load first={player.variants[0]!.timeline} {options} variantsUrl={variantsUrl(scenario)}>
    <Fragment set:html={firstCode} />
  </Player>

  {
    Writeup && (
      <article class="writeup" id="explanation" aria-labelledby="explanation-title">
        <p class="writeup-label" id="explanation-title">Explanation</p>
        <Writeup />
        {
          faq.length > 0 && (
            <section class="faq" aria-labelledby="faq-title">
              <h2 id="faq-title">Common questions</h2>
              {faq.map(({ q, a }) => (
                <>
                  <h3>{q}</h3>
                  <p set:html={inlineCodeHtml(a)} />
                </>
              ))}
            </section>
          )
        }
        {
          program && (
            <p class="verified">
              Verified: this timeline matches a real program, checked in CI on JDK 21 and 25.{' '}
              <a href={program}>See the program</a>
            </p>
          )
        }
      </article>
    )
  }

  {
    related.length > 0 && (
      <nav class="related" aria-labelledby="related-title">
        <h2 id="related-title">More in {scenario.group}</h2>
        <ul>
          {related.map((r) => (
            <li>
              <a href={scenarioUrl(r)}>{r.title}</a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }

  <nav class="pager" aria-label="More scenarios">
    {
      prev ? (
        <a class="prev" href={scenarioUrl(prev)}>
          <span>Previous</span>
          {prev.title}
        </a>
      ) : (
        <span />
      )
    }
    {
      next && (
        <a class="next" href={scenarioUrl(next)}>
          <span>Next</span>
          {next.title}
        </a>
      )
    }
  </nav>
</Base>

<style>
  .topbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    padding-top: 20px;
  }

  .steppers {
    display: flex;
    gap: 6px;
  }

  .steppers a,
  .steppers .disabled {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 36px;
    padding: 0 12px;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 13px;
    text-decoration: none;
    white-space: nowrap;
  }

  .steppers a {
    background: var(--surface);
    transition: border-color 120ms;
  }

  .steppers a:hover {
    border-color: var(--muted);
  }

  .steppers .disabled {
    color: var(--muted);
    border-style: dashed;
  }

  .intro {
    padding: 14px 0 18px;
  }

  .jump {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    margin-top: 4px;
    color: var(--accent);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
  }

  .jump:hover {
    text-decoration: underline;
  }

  .writeup-label {
    margin: 0;
    font: 500 12px/1 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .crumbs {
    margin: 0;
    font: 12px var(--font-mono);
    color: var(--muted);
    letter-spacing: 0.04em;
  }

  .crumbs a {
    color: var(--muted);
  }

  h1 {
    margin: 0;
    font-size: clamp(24px, 4vw, 34px);
    font-weight: 600;
    line-height: 1.2;
    text-wrap: balance;
  }

  .summary {
    margin: 8px 0 0;
    color: var(--muted);
    max-width: 62ch;
  }

  .writeup {
    max-width: 70ch;
    margin: 48px 0 0;
    padding-top: 24px;
    scroll-margin-top: 16px;
    border-top: 1px solid var(--border);
    font-size: 16px;
    line-height: 1.65;
  }

  .writeup :global(h2) {
    margin: 32px 0 8px;
    font-size: 19px;
    font-weight: 600;
  }

  .writeup :global(p),
  .writeup :global(ul),
  .writeup :global(ol) {
    margin: 0 0 14px;
  }

  .writeup :global(li) {
    margin: 4px 0;
  }

  .writeup :global(li::marker) {
    color: var(--muted);
  }

  .writeup :global(strong) {
    font-weight: 600;
    color: var(--text-strong);
  }

  .writeup :global(:not(pre) > code) {
    padding: 1px 5px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 4px;
    font-size: 0.88em;
    overflow-wrap: anywhere; /* long calls like Runtime.getRuntime()... must wrap on phones */
  }

  .writeup :global(pre) {
    margin: 0 0 16px;
    padding: 12px 16px;
    overflow-x: auto;
    background: var(--surface) !important;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-size: 13.5px;
    line-height: 1.6;
  }

  .writeup :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    margin: 0 0 16px;
    border-collapse: collapse;
    font-size: 14px;
  }

  .writeup :global(td code) {
    white-space: nowrap;
    overflow-wrap: normal;
  }

  .writeup :global(th),
  .writeup :global(td) {
    padding: 8px 12px;
    border-bottom: 1px solid var(--border);
    text-align: left;
    vertical-align: top;
  }

  .writeup :global(th) {
    color: var(--muted);
    font-weight: 500;
  }

  .writeup .faq :global(h3) {
    margin: 20px 0 6px;
    font-size: 16px;
    font-weight: 600;
  }

  .verified {
    margin-top: 32px;
    padding: 12px 16px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-size: 14px;
    color: var(--muted);
  }

  .verified a {
    display: inline-block;
    padding: 12px 0;
    margin: -12px 0;
    color: var(--accent);
    font-weight: 500;
  }

  .related {
    max-width: 70ch;
    margin-top: 40px;
  }

  .related h2 {
    margin: 0 0 8px;
    font: 500 12px/1 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .related ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .related a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 14px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 14px;
    text-decoration: none;
    transition: border-color 120ms;
  }

  .related a:hover {
    border-color: var(--muted);
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 48px;
  }

  .pager a {
    display: grid;
    gap: 2px;
    padding: 14px 16px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    font-weight: 500;
    transition: border-color 120ms;
  }

  .pager a:hover {
    border-color: var(--muted);
  }

  .pager span {
    font: 12px var(--font-mono);
    color: var(--muted);
  }

  .pager .next {
    grid-column: 2;
    text-align: right;
  }

  @media (max-width: 560px) {
    .pager {
      grid-template-columns: 1fr;
    }

    .pager .next {
      grid-column: 1;
    }
  }
</style>
